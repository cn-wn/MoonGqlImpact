----
import {
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/json",
  "moonbitlang/async@0.22.5",
}
----

async fn demo() -> Unit {
  let old = "examples/apollo/old.graphql"
  let next = "examples/apollo/new.graphql"
  let prefix = ["run", "cmd/check", "--target", "native", "--"]
  let files = [
    "flight-board", "examples/apollo/flight-board.graphql",
    "flight-board", "examples/apollo/launch-date.graphql",
    "crew-roster", "examples/apollo/crew-roster.graphql",
  ]
  let help = @shell.Cmd("moon", [..prefix, "--help"]).output()
  help.check()
  assert_true(help.stdout().contains("--observed-only"))
  assert_true(help.stdout().contains("--schema-only"))
  let clean = @shell.Cmd("moon", [..prefix, old, old, ..files]).output()
  clean.check()
  guard @json.parse(clean.stdout()) is {
    "format_version": 1, "changes": [],
    "coverage": [
      { "name": "flight-board", "operations": [{ "name": "FlightBoard", .. }], .. },
      { "name": "crew-roster", "operations": [{ "name": "CrewRoster", .. }], .. },
    ], ..
  } else {
    fail("unexpected coverage in a clean report: " + clean.stdout())
  }
  let changed = @shell.Cmd("moon", [..prefix, old, next, ..files]).output()
  assert_eq(changed.exit_code(), 1)
  let report = @json.parse(changed.stdout())
  guard report is { "changes": [
    { "coordinate": "Mission.launchDate", "impacts": [
      { "client": "flight-board", "response_path": ["missions", "launch"], .. },
    ], .. },
    { "coordinate": "Mission.crew", "impacts": [
      { "client": "crew-roster", "response_path": ["missions", "crew"], .. },
    ], .. },
  ], .. } else {
    fail("unexpected Apollo upgrade report: " + changed.stdout())
  }
  let config_args = [..prefix, "--config", "examples/apollo/check.json"]
  let configured = @shell.Cmd("moon", config_args).output()
  assert_eq(configured.exit_code(), 1)
  assert_eq(@json.parse(configured.stdout()), report)
  let config_markdown = @shell.Cmd("moon", [..config_args, "--markdown"]).output()
  assert_eq(config_markdown.exit_code(), 1)
  assert_true(config_markdown.stdout().contains("Mission.launchDate"))
  let conflicting = @shell.Cmd("moon", [..config_args, "--observed-only"]).output()
  assert_eq(conflicting.exit_code(), 2)
  assert_true(conflicting.stdout().contains("--config cannot be combined"))
  let invalid = @shell.Cmd(
    "moon",
    [..prefix, old, next, "web", "examples/apollo/launch-date.graphql"],
  ).output()
  assert_eq(invalid.exit_code(), 2)
  assert_true(invalid.stdout().contains("client must define a query"))
  let unused = ["names", "examples/apollo/mission-names.graphql"]
  let global = @shell.Cmd("moon", [..prefix, old, next, ..unused]).output()
  let observed = @shell.Cmd(
    "moon",
    [..prefix, "--observed-only", old, next, ..unused],
  ).output()
  assert_eq(global.exit_code(), 1)
  observed.check()
  assert_eq(@json.parse(global.stdout()), @json.parse(observed.stdout()))
  let affected = @shell.Cmd(
    "moon",
    [..prefix, "--observed-only", old, next, ..files],
  ).output()
  assert_eq(affected.exit_code(), 1)
  assert_eq(@json.parse(affected.stdout()), report)
  let schema_only = @shell.Cmd(
    "moon",
    [..prefix, "--schema-only", old, next],
  ).output()
  assert_eq(schema_only.exit_code(), 1)
  guard @json.parse(schema_only.stdout()) is {
    "format_version": 1, "changes": schema_changes, "coverage": [], ..
  } && @json.parse(global.stdout()) is { "changes": global_changes, .. } else {
    fail("unexpected schema-only report: " + schema_only.stdout())
  }
  assert_eq(schema_changes, global_changes)
  let schema_clean = @shell.Cmd(
    "moon",
    [..prefix, "--schema-only", old, old],
  ).output()
  schema_clean.check()
  for policy in [[], ["--observed-only"]] {
    let md = @shell.Cmd(
      "moon",
      [..prefix, "--markdown", ..policy, old, next, ..files],
    ).output()
    assert_eq(md.exit_code(), 1)
    assert_true(md.stdout().contains("# GraphQL upgrade impact"))
    assert_true(md.stdout().contains("flight-board"))
    assert_true(md.stdout().contains("Mission.crew"))
  }
  let md_clean = @shell.Cmd(
    "moon",
    [..prefix, "--markdown", "--schema-only", old, old],
  ).output()
  md_clean.check()
  assert_true(md_clean.stdout().contains("No contract regressions"))
  let duplicate_source = @shell.Cmd(
    "moon",
    [..prefix, old, next, "names", "examples/apollo/mission-names.graphql",
      "names", "examples/apollo/mission-names.graphql"],
  ).output()
  assert_eq(duplicate_source.exit_code(), 2)
  assert_true(duplicate_source.stdout().contains("unique nonempty paths"))
  let incomplete = @shell.Cmd("moon", [..prefix, old, next]).output()
  assert_eq(incomplete.exit_code(), 2)
  println("Apollo CLI demo passed (strict, observed-only, and schema-only policies)")
}

///|
async fn argument_demo() -> Unit {
  let base = [
    "run", "cmd/check", "--target", "native", "--", "--observed-only",
    "examples/arguments/old.graphql", "examples/arguments/new.graphql",
    "desktop", "examples/arguments/desktop.graphql",
  ]
  let safe = @shell.Cmd("moon", base).output()
  safe.check()
  guard @json.parse(safe.stdout()) is {
    "changes": [{ "coordinate": "Query.user(id:)", "impacts": [], .. }], ..
  } else {
    fail("expected an unobserved argument regression: " + safe.stdout())
  }
  let affected = @shell.Cmd(
    "moon",
    [..base, "mobile", "examples/arguments/mobile.graphql"],
  ).output()
  assert_eq(affected.exit_code(), 1)
  guard @json.parse(affected.stdout()) is {
    "changes": [{
      "coordinate": "Query.user(id:)",
      "previous_type": "ID",
      "proposed_type": "ID!",
      "impacts": [
        { "client": "mobile", "operation": "EditProfile", "response_path": ["profile"], .. },
        { "client": "mobile", "operation": "CurrentUser", .. },
      ],
      ..
    }], ..
  } else {
    fail("expected only mobile operations to be affected: " + affected.stdout())
  }
  let report_only = @shell.Cmd(
    "moon",
    [..base[:5], "--fail-on=notice", ..base[5:], "mobile", "examples/arguments/mobile.graphql"],
  ).output()
  report_only.check()
  assert_eq(@json.parse(report_only.stdout()), @json.parse(affected.stdout()))
  let by_reason = @shell.Cmd(
    "moon",
    [..base[:5], "--fail-on=ArgumentTypeChanged", ..base[5:], "mobile", "examples/arguments/mobile.graphql"],
  ).output()
  assert_eq(by_reason.exit_code(), 1)
  assert_eq(@json.parse(by_reason.stdout()), @json.parse(affected.stdout()))
  for option in ["--fail-on=", "--fail-on=risk,", "--fail-on=typo"] {
    let invalid = @shell.Cmd(
      "moon",
      [..base[:5], option, ..base[5:]],
    ).output()
    assert_eq(invalid.exit_code(), 2)
    assert_true(invalid.stdout().contains("Unknown gate category"))
  }
  println("Argument CLI demo passed (compatible, nullable, and omitted arguments)")
}

///|
async fn mutation_demo() -> Unit {
  let root = "examples/mutations/"
  let run = @shell.Cmd("moon", [
    "run", "cmd/check", "--target", "native", "--", "--observed-only", "--fail-on=breaking",
    root + "old.graphql", root + "new.graphql", "issue-client", root + "operations.graphql",
  ]).output()
  assert_eq(run.exit_code(), 1)
  guard @json.parse(run.stdout()) is {
    "changes": [{
      "coordinate": "CreateIssueInput.labelIds",
      "impacts": [{ "operation": "OpenWithoutLabels", "response_path": ["added"], .. }],
      ..
    }],
    "coverage": [{ "operations": [
      { "name": "ReadIssue", .. }, { "name": "OpenWithLabels", .. }, { "name": "OpenWithoutLabels", .. },
    ], .. }],
    "proposed_rejections": [{ "operation": "OpenWithoutLabels", .. }],
    ..
  } else {
    fail("unexpected mutation report: " + run.stdout())
  }
  println("Mixed query and mutation CLI demo passed")
}

///|
async fn scalar_contract_demo() -> Unit {
  let run = @shell.Cmd("moon", [
    "run", "cmd/check", "--target", "native", "--", "--config", "examples/scalar-contracts/check.json",
  ]).output()
  assert_eq(run.exit_code(), 1)
  guard @json.parse(run.stdout()) is {
    "changes": [],
    "proposed_rejections": [{"operation": "LegacyLiteral", ..}],
    "sample_assessments": [
      {"id":"short","status":"VariableRejected","path":"/amount", ..},
      {"id":"two-places","status":"Unchanged", ..},
    ], ..
  } else { fail("unexpected independent scalar rules report") }
  println("Different scalar contracts on identical SDL verified")
}

///|
fn main {
  @async.run_async_main(async fn() {
    demo()
    argument_demo()
    mutation_demo()
    scalar_contract_demo()
  })
}
