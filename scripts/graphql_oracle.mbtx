----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
let oracle : String =
  #|const path = require('node:path');
  #|const fs = require('node:fs');
  #|const graphql = require(path.resolve(process.argv[1]));
  #|const [before, after, queries, invalidMerge] = process.argv.slice(2);
  #|if (graphql.version !== '16.11.0') throw new Error('Expected graphql@16.11.0');
  #|const read = file => fs.readFileSync(file, 'utf8');
  #|const oldSchema = graphql.buildSchema(read(before));
  #|const newSchema = graphql.buildSchema(read(after));
  #|const documents = graphql.separateOperations(graphql.parse(read(queries)));
  #|const invalid = schema => Object.entries(documents)
  #|  .filter(([, document]) => graphql.validate(schema, document).length > 0)
  #|  .map(([name]) => name).sort();
  #|const variables = graphql.getOperationAST(documents.Runtime).variableDefinitions;
  #|const coerce = (schema, value) =>
  #|  graphql.getVariableValues(schema, variables, { filter: value });
  #|const accepts = (schema, value) => !coerce(schema, value).errors;
  #|const valid = {rules: [{status: 'READY'}]};
  #|console.log(JSON.stringify({
  #|  baseline_invalid: invalid(oldSchema),
  #|  proposed_invalid: invalid(newSchema),
  #|  nullable_runtime: [accepts(oldSchema, {rules: [{status: null}]}),
  #|    accepts(newSchema, {rules: [{status: null}]})],
  #|  valid_runtime: [accepts(oldSchema, {rules: [{status: 'READY'}]}),
  #|    accepts(newSchema, {rules: [{status: 'READY'}]})],
  #|  defaulted_input: [coerce(oldSchema, valid).coerced.filter.maxCount ?? null,
  #|    coerce(newSchema, valid).coerced.filter.maxCount],
  #|  singleton_list: coerce(newSchema, {rules: {status: 'READY'}}).coerced.filter.rules.length,
  #|  invalid_merge: graphql.validate(oldSchema, graphql.parse(read(invalidMerge))).length > 0,
  #|}));

///|
async fn verify(package_dir : String) -> Unit {
  let root = "examples/input-objects/"
  let old = root + "old.graphql"
  let next = root + "new.graphql"
  let queries = root + "queries.graphql"
  let invalid_merge = root + "invalid-merge.graphql"
  let reference = @shell.Cmd(
    "node", ["-e", oracle, package_dir, old, next, queries, invalid_merge],
  ).output()
  reference.check()
  guard @json.parse(reference.stdout()) is {
    "baseline_invalid": [],
    "proposed_invalid": invalid,
    "nullable_runtime": [true, false],
    "valid_runtime": [true, true],
    "defaulted_input": [Null, 5],
    "singleton_list": 1,
    "invalid_merge": true,
    ..
  } else {
    fail("unexpected GraphQL.js reference results: " + reference.stdout())
  }
  let ref_invalid : Array[String] = @json.from_json(invalid)
  assert_eq(ref_invalid, ["BookResult", "Default", "Missing", "Null"])
  let prefix = ["run", "cmd/check", "--target", "native", "--", "--observed-only"]
  let actual = @shell.Cmd("moon", [..prefix, old, next, "web", queries]).output()
  assert_eq(actual.exit_code(), 1)
  guard @json.parse(actual.stdout()) is {
    "changes": [
      {
        "coordinate": "Query.books",
        "reasons": [{ "code": "OutputNullabilityWeakened", .. }],
        "impacts": output_impacts, ..
      },
      { "coordinate": "Result", .. },
      { "coordinate": "Rule.status", "impacts": input_impacts, .. },
      { "coordinate": "BookFilter.maxCount", "impacts": default_impacts, .. },
    ], "proposed_rejections": rejections, ..
  } else {
    fail("unexpected upgrade report: " + actual.stdout())
  }
  let observed : Array[Json] = @json.from_json(rejections)
  let invalid_names = []
  for row in observed {
    guard row is {
      "operation": String(name),
      "reason": { "code": "ProposedOperationRejected", "severity": "Breaking", .. },
      ..
    } else {
      fail("expected a static rejection")
    }
    invalid_names.push(name)
  }
  assert_eq(invalid_names.length(), ref_invalid.length())
  assert_true(ref_invalid.all(name => invalid_names.contains(name)))
  let inputs : Array[Json] = @json.from_json(input_impacts)
  assert_true(inputs.any(hit => hit is {
    "operation": "Runtime", "reason_codes": ["InputVariableValueMayBreak"], ..
  }))
  assert_false(inputs.any(hit => hit is { "operation": "Safe" | "Merge", .. }))
  let defaults : Array[Json] = @json.from_json(default_impacts)
  assert_true(defaults.any(hit => hit is {
    "operation": "Safe", "reason_codes": ["InputFieldDefaultChanged"], ..
  }))
  let outputs : Array[Json] = @json.from_json(output_impacts)
  assert_true(outputs.any(hit => hit is { "operation": "Safe", .. }))
  let samples = @shell.Cmd("moon", [
    "run", "cmd/check", "--target", "native", "--", "--config", root + "check.json",
  ]).output()
  assert_eq(samples.exit_code(), 1)
  guard @json.parse(samples.stdout()) is {
    "sample_assessments": [
      { "id": "null-status", "status": "VariableRejected", "path": "/filter/rules/0/status", .. },
      { "id": "ready", "status": "CoercionChanged", "path": "/filter/maxCount", .. },
    ],
    ..
  } else {
    fail("MoonBit disagreed with the reference coercion results: " + samples.stdout())
  }
  let rejected = @shell.Cmd("moon", [..prefix, old, next, "web", invalid_merge]).output()
  assert_eq(rejected.exit_code(), 2)
  assert_true(rejected.stdout().contains("conflicting selections"))
  println("GraphQL.js 16.11.0 agrees on input, merge and fragment validation. Output contracts and runtime risk retain separate evidence.")
}

///|
let argument_oracle : String =
  #|const fs = require('node:fs');
  #|const path = require('node:path');
  #|const [library, root] = process.argv.slice(1);
  #|const gql = require(path.resolve(library));
  #|if (gql.version !== '16.11.0') throw new Error('Expected graphql@16.11.0');
  #|const read = name => fs.readFileSync(path.join(root, name), 'utf8');
  #|const document = gql.parse(read('operations.graphql'));
  #|const old = gql.buildSchema(read('old.graphql'));
  #|const next = gql.buildSchema(read('new.graphql'));
  #|const capture = args => JSON.stringify(args);
  #|const run = (schema, row) => gql.executeSync({
  #|  schema, document, operationName: row.operation, variableValues: row.variables,
  #|  rootValue: {lookup: capture, search: capture},
  #|});
  #|const names = JSON.parse(read('samples.json')).map(row => {
  #|  const before = run(old, row);
  #|  const after = run(next, row);
  #|  if (before.errors) throw new Error('Fixture has an invalid baseline sample');
  #|  const status = after.errors ? 'VariableRejected' :
  #|    JSON.stringify(before.data) === JSON.stringify(after.data) ? 'Unchanged' : 'CoercionChanged';
  #|  return {id: row.id, status};
  #|});
  #|console.log(JSON.stringify({
  #|  staticErrors: [gql.validate(old, document).length, gql.validate(next, document).length], names,
  #|}));

///|
async fn verify_arguments(package_dir : String) -> Unit {
  let root = "examples/argument-samples"
  let reference = @shell.Cmd("node", ["-e", argument_oracle, package_dir, root]).output()
  reference.check()
  guard @json.parse(reference.stdout()) is { "staticErrors": [0, 0], "names": expected, .. } else {
    fail("unexpected reference result: " + reference.stdout())
  }
  let actual = @shell.Cmd("moon", [
    "run", "cmd/check", "--target", "native", "--", "--config", root + "/check.json",
  ]).output()
  assert_eq(actual.exit_code(), 1)
  guard @json.parse(actual.stdout()) is {
    "proposed_rejections": [], "sample_assessments": Array(samples), ..
  } else {
    fail("unexpected argument report: " + actual.stdout())
  }
  let names = samples.map(row => {
    guard row is { "id": id, "status": status, .. } else { fail("missing sample result") }
    Json::object(Map([("id", id), ("status", status)]))
  })
  assert_eq(Json::array(names), expected)
  assert_true(samples[0] is {
    "argument_coordinate": "Query.lookup(id:)", "response_path": ["result"],
    "selection": {"line": 6, ..}, "path": "/id", ..
  })
  assert_true(samples[3] is {
    "argument_coordinate": "Query.search(filter:)", "response_path": ["hits"], "path": "/filter/tag", ..
  })
  println("GraphQL.js 16.11.0 agrees on seven field-argument samples")
}

///|
let one_of_oracle : String =
  #|const fs = require('node:fs');
  #|const path = require('node:path');
  #|const [library, root] = process.argv.slice(1);
  #|const gql = require(path.resolve(library));
  #|const read = name => fs.readFileSync(path.join(root, name), 'utf8');
  #|const before = gql.buildSchema(read('old.graphql'));
  #|const after = gql.buildSchema(read('new.graphql'));
  #|const operations = gql.separateOperations(gql.parse(read('operations.graphql')));
  #|if (Object.values(operations).some(operation => gql.validate(before, operation).length)) {
  #|  throw new Error('baseline operations must validate');
  #|}
  #|const rejected = Object.keys(operations).filter(name => gql.validate(after, operations[name]).length);
  #|const definitions = gql.getOperationAST(operations.Runtime).variableDefinitions;
  #|const samples = JSON.parse(read('samples.json')).map(row => {
  #|  if (gql.getVariableValues(before, definitions, row.variables).errors) throw new Error('invalid baseline sample');
  #|  return gql.getVariableValues(after, definitions, row.variables).errors ? 'VariableRejected' : 'Unchanged';
  #|});
  #|console.log(JSON.stringify({rejected,samples}));

///|
async fn verify_one_of(package_dir : String) -> Unit {
  let root = "examples/one-of"
  let reference = @shell.Cmd("node", ["-e", one_of_oracle, package_dir, root]).output()
  reference.check()
  guard @json.parse(reference.stdout()) is { "rejected": rejected, "samples": expected, .. } else {
    fail("missing @oneOf reference evidence")
  }
  let run = @shell.Cmd("moon", ["run", "cmd/check", "--target", "native", "--", "--config", root + "/check.json"]).output()
  assert_eq(run.exit_code(), 1)
  guard @json.parse(run.stdout()) is {
    "changes": [{"coordinate":"Match", ..}],
    "proposed_rejections": Array(rows), "sample_assessments": Array(samples), ..
  } else { fail("unexpected @oneOf comparison report") }
  let names : Array[String] = @json.from_json(rejected)
  assert_eq(names.length(), 4)
  assert_eq(rows.length(), names.length())
  for row in rows {
    guard row is { "operation": String(name), .. } else { fail("missing operation") }
    assert_true(names.contains(name))
  }
  let statuses = samples.map(row => {
    guard row is { "status": status, .. } else { fail("missing sample status") }
    status
  })
  assert_eq(Json::array(statuses), expected)
  println("GraphQL.js 16.11.0 agrees on @oneOf operation and variable validation")
}

///|
fn main {
  let args = @env.args()
  guard args.length() == 2 else {
    abort("Usage: moon run --deny-warn scripts/graphql_oracle.mbtx -- PATH_TO_GRAPHQL_JS")
  }
  @async.run_async_main(async fn() {
    verify(args[1])
    verify_arguments(args[1])
    verify_one_of(args[1])
  })
}
